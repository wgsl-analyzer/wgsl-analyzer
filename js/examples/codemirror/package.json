{
	"name": "wgsl-analyzer-codemirror-example",
	"version": "0.0.0",
	"private": true,
	"description": "Minimal CodeMirror editor backed by wgsl-analyzer in a Web Worker",
	"type": "module",
	"scripts": {
		"predev": "node scripts/copy-assets.mjs",
		"dev": "vite",
		"prebuild": "node scripts/copy-assets.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.2",
		"@codemirror/lint": "^6.9.1",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.40.1",
		"@marimo-team/codemirror-languageserver": "^2.0.0",
		"codemirror": "^6.0.2",
		"wgsl-analyzer-web": "workspace:*"
	},
	"devDependencies": {
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^25.9.5",
		"typescript": "^7.0.2",
		"vite": "^7.1.5"
