{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["vite/client"],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts"]
}
