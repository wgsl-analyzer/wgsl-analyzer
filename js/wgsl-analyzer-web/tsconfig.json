{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "es2022",
		// ES2024 for Atomics.waitAsync, which the worker uses to await stdout
		// without blocking its event loop.
		"lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmitOnError": true
	},
	"include": ["src"]
}
