{
	"extends": "@tsconfig/strictest/tsconfig.json",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmitOnError": true
	},
	"include": ["src"]
}
