{
	"name": "wgsl-analyzer-web",
	"version": "0.13.0-dev",
	"description": "Run the wgsl-analyzer language server in a Web Worker",
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/wgsl-analyzer/wgsl-analyzer"
	},
	"keywords": [
		"wgsl",
		"wesl",
		"language-server",
		"lsp",
		"wasm",
		"web-worker"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./assets/*": "./dist/assets/*"
	},
	"files": [
		"dist",
		"src",
		"LICENSE-APACHE",
		"LICENSE-MIT"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm run build:lib && pnpm run build:worker",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build:lib": "pnpm run clean && tsc",
		"build:worker": "vite build",
		"check": "pnpm exec biome check",
		"ci": "pnpm exec biome ci && pnpm run typecheck",
		"fix": "pnpm exec biome check --write",
		"format": "pnpm exec biome format --write",
		"lint": "pnpm exec biome lint",
		"prepack": "node -e \"for(const f of ['LICENSE-APACHE','LICENSE-MIT'])require('node:fs').copyFileSync('../../'+f,f)\"",
		"test": "node --test \"tests/unit/*.test.ts\"",
		"test:smoke": "node --test --test-force-exit --test-concurrency=1 \"tests/smoke/*.test.ts\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vscode-jsonrpc": "^9.0.3"
	}
}
