{
	extends: [
		"group:monorepos",
		"helpers:githubDigestChangelogs",
		"mergeConfidence:all-badges",
		"replacements:all",
		"schedule:daily",
		"workarounds:all",
	],
	ignorePaths: [
		"crates/wgsl-analyzer/src/tests/bevy/**"
	],
	labels: [
		"C-Dependencies",
		"D-Trivial",
		"S-Ready-to-Review",
	],
	minimumReleaseAge: "7 days",
	postUpdateOptions: ["pnpmDedupe"],
	packageRules: [
		{
			description: "Group not-breaking updates",
			matchUpdateTypes: ["minor", "patch", "digest"],
			matchJsonata: ["isBreaking != true and (newMajor != 0 or updateType != 'minor')"],
			groupName: "not-breaking"
		},
		{
			description: "Rust dependencies",
			matchManagers: ["cargo"],
			addLabels: ["A-Language-Server"],
		},
		{
			description: "Workflow dependencies",
			matchManagers: ["github-actions", "dockerfile"],
			addLabels: ["A-Build-System"],
		},
		{
			description: "Editor dependencies",
			matchManagers: ["npm"],
			addLabels: ["A-Editor"],
		},
		{
			description: "Group CodeQL updates",
			matchManagers: ["github-actions"],
			matchPackageNames: ["/^github\\/codeql-action\\//"],
			groupName: "codeql-action",
		},
		{
			description: "Update @types/vscode together with engines.vscode",
			matchManagers: ["npm"],
			matchDepNames: ["@types/vscode", "vscode"],
			groupName: "vscode",
			addLabels: ["A-Editor"],
		},
		{
			description: "Resolve engines.vscode from @types/vscode",
			matchManagers: ["npm"],
			matchDepNames: ["vscode"],
			matchDepTypes: ["engines"],
			overrideDatasource: "npm",
			overridePackageName: "@types/vscode",
		},
		{
			description: "Delay VS Code minor updates",
			matchManagers: ["npm"],
			matchDepNames: ["@types/vscode", "vscode"],
			matchUpdateTypes: ["minor"],
			minimumReleaseAge: "90 days",
		},
		{
			description: "Use @tsconfig/node24",
			matchPackageNames: ["@tsconfig/node24"],
			replacementName: null,
			replacementVersion: null,
		},
		{
			description: "Node runtime, types and tsconfig move together",
			matchDatasources: ["node-version", "npm"],
			matchPackageNames: ["node", "@types/node", "/^@tsconfig\\/node\\d+$/"],
			groupName: "node",
		},
		{
			description: "Stay on Node 24",
			matchDatasources: ["node-version"],
			matchPackageNames: ["node"],
			allowedVersions: "<25",
		},
		{
			description: "Match @types/node to the Node major",
			matchPackageNames: ["@types/node"],
			allowedVersions: "<25",
		},
		{
			description: "Ignore idna_adapter",
			matchManagers: ["cargo"],
			matchPackageNames: ["idna_adapter"],
			enabled: false,
		},
		{
			description: "Ignore naga",
			matchManagers: ["cargo"],
			matchPackageNames: ["naga"],
			enabled: false,
		}
	],
	rangeStrategy: "bump",
}
