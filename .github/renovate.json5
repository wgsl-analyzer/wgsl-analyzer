{
	extends: [
		"group:allNonMajor",
		"group:monorepos",
		"helpers:disableTypesNodeMajor",
		"helpers:githubDigestChangelogs",
		"mergeConfidence:all-badges",
		"replacements:all",
		"schedule:daily",
		"workarounds:all",
	],
	labels: [
		"C-Dependencies",
		"D-Trivial",
		"S-Ready-to-Review",
	],
	minimumReleaseAge: "7 days",
	packageRules: [
		{
			description: "Rust dependencies",
			matchManagers: ["cargo"],
			addLabels: ["A-Language-Server"],
		},
		{
			description: "Workflow dependencies",
			matchManagers: ["github-actions", "docker"],
			addLabels: ["A-Build-System"],
		},
		{
			description: "Editor dependencies",
			matchManagers: ["npm"],
			addLabels: ["A-Editor"],
		},
		{
			description: "Group CodeQL updates",
			matchManagers: ["github-actions"],
			matchPackageNames: ["/^github\\/codeql-action\\//"],
		},
		{
			description: "Delay VS Code minor updates",
			matchManagers: ["npm"],
			matchPackageNames: ["@types/vscode"],
			matchUpdateTypes: ["minor"],
			minimumReleaseAge: "90 days",
			addLabels: ["A-Editor"],
		},
		{
			description: "Keep engines.vscode aligned with @types/vscode",
			matchManagers: ["npm"],
			matchPackageNames: ["@types/vscode"],
			postUpgradeTasks: {
				commands: [
					"node -e \"const fs=require('fs'); const f='editors/code/package.json'; const p=JSON.parse(fs.readFileSync(f)); const v=p.devDependencies?.['@types/vscode']; if (!v) process.exit(0); const version=v.replace(/^[^0-9]*/, ''); p.engines ??= {}; p.engines.vscode='^'+version; fs.writeFileSync(f, JSON.stringify(p, null, 2)+'\\n');\"",
					"pnpm --dir editors/code install --lockfile-only",
					"pnpm --dir editors/code run format",
				],
				fileFilters: [
					"editors/code/package.json",
					"editors/code/pnpm-lock.yaml",
				],
				executionMode: "branch",
			},
		},
		{
			"description": "Use @tsconfig/node24",
			"matchPackageNames": ["@tsconfig/node24"],
			"replacementName": null,
			"replacementVersion": null,
		},
		{
			"description": "Use Node.js 24",
			"matchManagers": ["node"],
			"matchPackageNames": ["node"],
			"allowedVersions": "<25"
		},
		{
			"description": "Ignore idna_adapter",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["idna_adapter"],
			"enabled": false,
		},
		{
			"description": "Ignore legacy nagas",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["naga27", "naga28", "naga29"],
			"enabled": false,
		}
	],
}
