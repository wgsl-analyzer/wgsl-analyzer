{
	extends: [
		"group:monorepos",
		"helpers:disableTypesNodeMajor",
		"helpers:githubDigestChangelogs",
		"mergeConfidence:all-badges",
		"replacements:all",
		"schedule:daily",
		"workarounds:all",
	],
	ignorePaths: [
		"crates/wgsl-analyzer/src/tests/bevy/**"
	],
	labels: [
		"C-Dependencies",
		"D-Trivial",
		"S-Ready-to-Review",
	],
	minimumReleaseAge: "7 days",
	postUpdateOptions: ["pnpmDedupe"],
	packageRules: [
		{
			"description": "Group not-breaking updates",
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"matchJsonata": ["isBreaking != true"],
			"groupName": "not-breaking"
		},
		{
			"description": "Cargo not-breaking 0.x patches",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["patch"],
			"matchCurrentVersion": ">=0.1.0 <1.0.0",
			"groupName": "not-breaking"
		},
		{
			description: "Rust dependencies",
			matchManagers: ["cargo"],
			addLabels: ["A-Language-Server"],
		},
		{
			description: "Workflow dependencies",
			matchManagers: ["github-actions", "docker"],
			addLabels: ["A-Build-System"],
		},
		{
			description: "Editor dependencies",
			matchManagers: ["npm"],
			addLabels: ["A-Editor"],
		},
		{
			description: "Group CodeQL updates",
			matchManagers: ["github-actions"],
			matchPackageNames: ["/^github\\/codeql-action\\//"],
		},
		{
			description: "Update @types/vscode together with engines.vscode",
			matchManagers: ["npm"],
			matchDepNames: ["@types/vscode", "vscode"],
			groupName: "vscode",
			addLabels: ["A-Editor"],
		},
		{
			description: "Resolve engines.vscode from @types/vscode",
			matchManagers: ["npm"],
			matchDepNames: ["vscode"],
			matchDepTypes: ["engines"],
			overrideDatasource: "npm",
			overridePackageName: "@types/vscode",
		},
		{
			description: "Delay VS Code minor updates",
			matchManagers: ["npm"],
			matchDepNames: ["@types/vscode", "vscode"],
			matchUpdateTypes: ["minor"],
			minimumReleaseAge: "90 days",
		},
		{
			"description": "Use @tsconfig/node24",
			"matchPackageNames": ["@tsconfig/node24"],
			"replacementName": null,
			"replacementVersion": null,
		},
		{
			"description": "Use Node.js 24",
			"matchManagers": ["node"],
			"matchPackageNames": ["node"],
			"allowedVersions": "<25"
		},
		{
			"description": "Ignore idna_adapter",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["idna_adapter"],
			"enabled": false,
		},
		{
			"description": "Ignore naga",
			"matchManagers": ["cargo"],
			"matchPackageNames": ["naga"],
			"enabled": false,
		}
	],
	rangeStrategy: "bump",
}
